<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:name=".HomeMoneyApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme.NoActionBar"
        android:usesCleartextTraffic="true"
        android:largeHeap="true">
    
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation"
            android:name=".MainActivity"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <activity
            android:name=".ui.eol.EolManageActivity"
            android:theme="@style/AppTheme.Eol"
            android:exported="true"
            android:launchMode="singleTask">

            <!-- GPC 授权登录回跳深链：gpc://oauth/callback?code=...&state=... -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="gpc"
                    android:host="oauth"
                    android:path="/callback" />
            </intent-filter>
        </activity>

        <!-- 移除 WorkManager 默认初始化，使用自定义配置 -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                tools:node="remove" />
        </provider>
        </application>

    <!-- 包可见性（Android 11+ / targetSdk 30+ 限制）：
         声明需交互的 GPC 包与深链 scheme，否则 getPackageInfo / resolveActivity
         即便 GPC 已安装也会返回“未安装”，导致误报。 -->
    <queries>
        <package android:name="com.pig.coin" />
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="gpc" />
        </intent>
        <!-- 授权页用系统浏览器打开，需让 http/https 的 BROWSABLE 可见 -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="http" />
        </intent>
    </queries>

    <!-- Permissions
         仅保留实际用到的：
         - INTERNET：Retrofit / OkHttp 访问 Ollama 与钱包服务
         - ACCESS_NETWORK_STATE：NetworkMonitor、HealthCheckService 通过
           ConnectivityManager 判断联网状态（android.net.conn.CONNECTIVITY_CHANGE 相关
           查询在部分 ROM 上仍要求此权限），属普通权限、无需运行时申请
         已移除：ACCESS_WIFI_STATE（无任何 WifiManager 调用）、
                 CAMERA（无任何相机调用，且从未运行时申请），
                 随之移除配套的 uses-feature android.hardware.camera。
         注意：WAKE_LOCK / RECEIVE_BOOT_COMPLETED / FOREGROUND_SERVICE 由 work-runtime
         库合并带入，SyncWorker 为周期性任务（开机后需恢复调度），不可移除。 -->

    <uses-permission android:name="android.permission.INTERNET"
        tools:ignore="ManifestOrder" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
</manifest>
