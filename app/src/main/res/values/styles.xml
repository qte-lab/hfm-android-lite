<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- 基础应用主题（迁移到传统 View 体系：Material Components DayNight）。
         所有变体（浅色/深色、API 分级）都继承此 Base，避免在各限定符目录重复定义
         导致桥接属性（colorOutline / textAppearanceTitle*）丢失而崩溃（见第七轮事故）。 -->

    <style name="AppTheme.Base" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>

        <!-- 品牌配色（颜色值随 values-night 自动切换深浅） -->
        <item name="colorPrimary">@color/brand_primary</item>
        <item name="colorPrimaryVariant">@color/brand_primary_variant</item>
        <item name="colorSecondary">@color/brand_secondary</item>
        <item name="colorSecondaryVariant">@color/brand_secondary_variant</item>
        <item name="colorOnPrimary">@color/on_primary</item>
        <item name="colorOnSecondary">@color/on_secondary</item>
        <item name="colorError">@color/app_error</item>
        <item name="colorOnError">@color/on_error</item>
        <item name="colorSurface">@color/app_surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="android:colorBackground">@color/app_background</item>
        <item name="colorOnBackground">@color/text_primary</item>

        <!-- MD3 颜色属性桥接：布局里用 ?attr/colorOutline 作分割线，MD2 主题未定义该属性，
             运行时解析失败会导致 InflateException 崩溃。此处映射到 divider 颜色（随深浅切换）。 -->
        <item name="colorOutline">@color/divider</item>

        <item name="android:windowBackground">@color/app_background</item>
        <item name="android:statusBarColor">@color/app_surface</item>
        <!-- 导航栏默认黑色：保证老旧设备（API < 27，不支持 windowLightNavigationBar，
             系统按钮固定白色）在浅色主题下白色按钮依然可见。API 27+ 在 values-v27
             中改回浅色并开启 windowLightNavigationBar 使用深色按钮。 -->
        <item name="android:navigationBarColor">@android:color/black</item>
        <item name="android:windowLightStatusBar">@bool/light_system_bars</item>

        <!-- MD3 排版属性桥接到 MD2 文本样式：布局里用 ?attr/textAppearanceTitleMedium 等
             MD3 命名，但本工程主题是 MD2（Theme.MaterialComponents），MD3 排版属性在
             MD2 主题下默认未赋值，会导致字号/字重不生效。此处按 MD3→MD2 映射补齐，
             使既有布局无需逐个改写即可正确显示（映射同 migrate_md2.py）。 -->
        <item name="textAppearanceTitleLarge">@style/TextAppearance.MaterialComponents.Headline6</item>
        <item name="textAppearanceTitleMedium">@style/TextAppearance.MaterialComponents.Subtitle1</item>
        <item name="textAppearanceTitleSmall">@style/TextAppearance.MaterialComponents.Subtitle2</item>
        <item name="textAppearanceBodyLarge">@style/TextAppearance.MaterialComponents.Body1</item>
        <item name="textAppearanceBodyMedium">@style/TextAppearance.MaterialComponents.Body2</item>
        <item name="textAppearanceBodySmall">@style/TextAppearance.MaterialComponents.Caption</item>
    </style>

    <!-- 默认（< API 27）使用的主题：直接继承 AppTheme.Base。
         API 27+ 在 values-v27 / values-night-v27 中以同名样式覆盖，仅追加导航栏相关项，
         因为同名样式在更具体限定符目录会整体替换而非合并，所以必须由 AppTheme.Base 继承。 -->
    <style name="AppTheme.NoActionBar" parent="AppTheme.Base" />

    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
    </style>

    <!-- 日期选择器主题（适配浅色/深色模式） -->
    <style name="DatePickerDialogLight" parent="android:Theme.Material.Light.Dialog">
        <item name="android:colorAccent">#FF66BB6A</item>
    </style>

    <style name="DatePickerDialogDark" parent="android:Theme.Material.Dialog">
        <item name="android:colorAccent">#FF66BB6A</item>
        <item name="android:textColorPrimary">#FFFFFFFF</item>
        <item name="android:textColorSecondary">#FFB0B0B0</item>
        <item name="android:windowBackground">#FF1E1E1E</item>
        <item name="android:colorBackground">#FF1E1E1E</item>
    </style>

    <!-- UCrop Theme - 确保不占用状态栏空间 -->
    <style name="UCropTheme" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
        <item name="android:windowTranslucentStatus">true</item>
        <item name="android:windowTranslucentNavigation">true</item>
        <item name="android:windowBackground">@android:color/white</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowFullscreen">false</item>
        <item name="android:fitsSystemWindows">true</item>
    </style>
</resources>