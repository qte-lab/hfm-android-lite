<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- 基础应用主题：原生 Holo 蓝（无 Material/AppCompat 桥接、无自定义组件）。
         compileSdk 37 下 android:Theme.Holo.Light 可正常 link（Holo 仅在 API 28
         被 deprecated，从未从框架移除）。强调色 brand_primary #33B5E5 即框架原生
         colorAccent，深色模式走 values-night/* 资源限定符翻色。 -->

    <style name="AppTheme.Base" parent="android:Theme.Holo.Light">
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>

        <!-- 全部使用框架原生 Holo 属性 -->
        <item name="android:colorAccent">@color/brand_primary</item>
        <item name="android:colorBackground">@color/app_background</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:windowBackground">@color/app_background</item>
        <item name="android:actionBarStyle">@style/HoloActionBar</item>
        <item name="android:statusBarColor">@color/app_surface</item>
        <!-- 状态栏图标深浅跟随深浅模式：浅色模式用深色图标、深色模式用浅色图标。
             @bool/light_system_bars 在 values/bools.xml=true、values-night/bools.xml=false。 -->
        <item name="android:windowLightStatusBar">@bool/light_system_bars</item>
        <!-- 老旧设备（API < 27）导航栏固定黑色，保证白色系统按钮可见 -->
        <item name="android:navigationBarColor">@android:color/black</item>
    </style>

    <!-- Holo 蓝 ActionBar 背景（ActionBar 在本应用各页均被 windowActionBar=false 隐藏，
         此处仅保留蓝底覆盖；不继承平台 Widget.Holo.ActionBar，避免引用不存在的平台样式）。 -->
    <style name="HoloActionBar">
        <item name="android:background">@color/brand_primary</item>
    </style>

    <!-- 默认（< API 27）使用的主题：直接继承 AppTheme.Base。
         API 27+ 在 values-v27 中以同名样式覆盖，仅追加导航栏相关项。 -->
    <style name="AppTheme.NoActionBar" parent="AppTheme.Base" />

    <!-- EOL 管理页基础主题（纯原生 Holo，无 AppCompat 命名空间属性）。
         EolManageActivity 已改为 FragmentActivity，仅用 android: 窗口属性隐藏 ActionBar。 -->
    <style name="AppTheme.EolBase" parent="android:Theme.Holo.Light">
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>

        <item name="android:colorAccent">@color/brand_primary</item>
        <item name="android:colorBackground">@color/app_background</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:windowBackground">@color/app_background</item>
        <item name="android:actionBarStyle">@style/HoloActionBar</item>
        <item name="android:statusBarColor">@color/app_surface</item>
        <item name="android:windowLightStatusBar">@bool/light_system_bars</item>
        <item name="android:navigationBarColor">@android:color/black</item>
    </style>

    <!-- EOL 管理页主题（默认目录）：显式继承 EolBase，供 EolManageActivity 使用。 -->
    <style name="AppTheme.Eol" parent="AppTheme.EolBase" />

    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
    </style>

    <!-- 日期选择器主题（原生 Holo，蓝色强调） -->
    <style name="DatePickerDialogLight" parent="android:Theme.Holo.Light.Dialog">
        <item name="android:colorAccent">@color/brand_primary</item>
    </style>

    <style name="DatePickerDialogDark" parent="android:Theme.Holo.Dialog">
        <item name="android:colorAccent">@color/brand_primary</item>
        <item name="android:textColorPrimary">#FFFFFFFF</item>
        <item name="android:textColorSecondary">#FFB0B0B0</item>
        <item name="android:windowBackground">#FF1E1E1E</item>
        <item name="android:colorBackground">#FF1E1E1E</item>
    </style>

    <!-- 通用对话框主题：继承 AppTheme.Base（含全部原生 Holo 属性），供按需引用。 -->
    <style name="AppTheme.Dialog" parent="AppTheme.Base">
        <item name="android:windowFrame">@null</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowAnimationStyle">@android:style/Animation.Dialog</item>
    </style>
</resources>
