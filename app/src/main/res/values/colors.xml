<?xml version="1.0" encoding="utf-8"?>
<!-- 全局配色（浅色 Holo）。Holo 蓝 #33B5E5 作为强调色，背景/表面为浅灰+白。 -->
<resources>
    <!-- Holo 蓝（强调色） -->
    <color name="brand_primary">#FF33B5E5</color>
    <color name="brand_primary_variant">#FF0099CC</color>
    <color name="brand_secondary">#FF33B5E5</color>
    <color name="brand_secondary_variant">#FF0099CC</color>

    <!-- 背景 / 表面 -->
    <color name="app_background">#FFF3F3F3</color>
    <color name="app_surface">#FFFFFFFF</color>
    <color name="app_error">#FFCC0000</color>

    <!-- 前景 -->
    <color name="on_primary">#FFFFFFFF</color>
    <color name="on_secondary">#FF000000</color>
    <color name="on_error">#FFFFFFFF</color>
    <color name="text_primary">#FF000000</color>
    <color name="text_secondary">#FF666666</color>
    <color name="divider">#1F000000</color>

    <!-- 控件按下高亮（ripple），自适应深浅：浅色模式深灰、深色模式浅灰 -->
    <color name="control_highlight">#40333333</color>

    <!-- Holo 调色板备用 -->
    <color name="holo_blue">#FF33B5E5</color>
    <color name="holo_blue_dark">#FF0099CC</color>
    <color name="holo_green">#FF99CC00</color>
    <color name="holo_red">#FFCC0000</color>

    <!-- EOL 网页端引导卡片：Holo 蓝低透明度底（深色模式另有覆盖） -->
    <color name="eol_portal_card_bg">#1A33B5E5</color>
</resources>
