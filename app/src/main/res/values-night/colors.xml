<?xml version="1.0" encoding="utf-8"?>
<!-- 深色模式配色：覆盖浅色 colors.xml 中的背景/表面/前景色，使深色模式真正变暗。
     强调色 brand_primary（Holo 蓝 #33B5E5）予以保留，在深色背景上对比度足够；
     on_*/app_error 等同样沿用浅色定义，无需在此重复。 -->
<resources>
    <!-- 背景 / 表面：深色 -->
    <color name="app_background">#FF121212</color>
    <color name="app_surface">#FF1E1E1E</color>

    <!-- 前景：浅色 -->
    <color name="text_primary">#FFE1E1E1</color>
    <color name="text_secondary">#FFB0B0B0</color>

    <!-- 分隔线：白色低透明度（在深色背景上显现为浅色细线） -->
    <color name="divider">#1FFFFFFF</color>

    <!-- EOL 网页端引导卡片：深色背景下提高蓝色底透明度，保证文字可读 -->
    <color name="eol_portal_card_bg">#2E33B5E5</color>
</resources>
