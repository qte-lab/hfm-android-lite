<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- 网页端引导链接卡片：点击跳转 http://192.168.10.9:3010 -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardWebPortal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?android:attr/selectableItemBackground"
            app:cardBackgroundColor="@color/eol_portal_card_bg"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp"
                android:paddingVertical="14dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:text="@string/eol_web_portal_card_text"
                    android:textAppearance="?android:textAppearanceSmall"
                    android:textColor="@color/text_primary" />

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="@string/eol_web_portal_card_text"
                    android:src="@drawable/ic_set_chevron"
                    android:tint="@color/holo_blue" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- 当前 EOL 状态 -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardBackgroundColor="@color/app_surface"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="@string/eol_current_title"
                    android:textAppearance="?android:textAppearanceMedium"
                    android:textColor="@color/text_primary" />

                <TextView
                    android:id="@+id/tvEolDate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="?android:textAppearanceMedium"
                    android:textColor="@color/holo_blue"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvEolHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textAppearance="?android:textAppearanceSmall"
                    android:textColor="@color/text_secondary" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- GPC 账号绑定 -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardBackgroundColor="@color/app_surface"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="@string/eol_gpc_account_title"
                    android:textAppearance="?android:textAppearanceMedium"
                    android:textColor="@color/text_primary" />

                <TextView
                    android:id="@+id/tvBindStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:textAppearance="?android:textAppearanceSmall"
                    android:textColor="@color/text_secondary" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnBind"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/eol_bind"
                        android:textSize="14sp" />

                    <Button
                        android:id="@+id/btnUnbind"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:text="@string/eol_unbind"
                        style="?android:attr/buttonStyle" />
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- EOL 延期购买 -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardBackgroundColor="@color/app_surface"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    android:text="@string/eol_extend_title"
                    android:textAppearance="?android:textAppearanceMedium"
                    android:textColor="@color/text_primary" />

                <TextView
                    android:id="@+id/tvEolPrice"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:textAppearance="?android:textAppearanceSmall"
                    android:textColor="@color/text_secondary" />

                <TextView
                    android:id="@+id/tvEolTotal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:textAppearance="?android:textAppearanceMedium"
                    android:textColor="@color/holo_blue"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnBuyEol"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/eol_buy_extend" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- 新功能移植购买 -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardFeaturePort"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardBackgroundColor="@color/app_surface"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    android:text="@string/eol_port_title"
                    android:textAppearance="?android:textAppearanceMedium"
                    android:textColor="@color/text_primary" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:text="@string/eol_port_desc"
                    android:textAppearance="?android:textAppearanceSmall"
                    android:textColor="@color/text_secondary" />

                <EditText
                    android:id="@+id/editPortAmount"
                    style="@android:style/Widget.AutoCompleteTextView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    android:hint="@string/eol_port_amount_hint"
                    android:inputType="numberDecimal"
                    android:maxLines="1"
                    android:padding="10dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:text="@string/eol_port_notice"
                    android:textAppearance="?android:textAppearanceSmall"
                    android:textColor="@color/text_secondary" />

                <Button
                    android:id="@+id/btnBuyPort"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/eol_buy_port" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <TextView
            android:id="@+id/textError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/app_error"
            android:textAppearance="?android:textAppearanceSmall"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>
