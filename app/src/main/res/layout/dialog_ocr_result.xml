<?xml version="1.0" encoding="utf-8"?>
<!-- OCR 结果确认弹窗：展示从图片提取的文字，用户可查看/修改后再发送给 AI -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <TextView
        android:id="@+id/tvOcrHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/ai_expense_ocr_hint"
        android:textSize="13sp"
        android:textColor="@color/text_secondary" />

    <EditText
        android:id="@+id/etOcrText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/btn_outline_background"
        android:padding="12dp"
        android:gravity="top|start"
        android:inputType="textMultiLine"
        android:minLines="6"
        android:maxLines="12"
        android:scrollbars="vertical"
        android:textSize="14sp"
        android:textColor="@color/text_primary"
        android:hint="@string/ai_expense_text_hint"
        android:textColorHint="@color/text_secondary" />

</LinearLayout>
