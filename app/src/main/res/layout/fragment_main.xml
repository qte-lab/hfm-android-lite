<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- 顶部 Tab 栏：仅文字，选中文字变色 + 底部圆点（替代原底部导航） -->
    <LinearLayout
        android:id="@+id/top_nav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurface"
        android:orientation="horizontal"
        android:weightSum="3"
        android:elevation="2dp"
        android:paddingVertical="6dp">

        <LinearLayout
            android:id="@+id/tab_expense"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:paddingVertical="6dp">

            <TextView
                android:id="@+id/tab_expense_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/expense_list_title"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textStyle="bold" />

            <View
                android:id="@+id/tab_expense_indicator"
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/tab_indicator_dot"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tab_charts"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:paddingVertical="6dp">

            <TextView
                android:id="@+id/tab_charts_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/charts_title"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textStyle="bold" />

            <View
                android:id="@+id/tab_charts_indicator"
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/tab_indicator_dot"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tab_settings"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:paddingVertical="6dp">

            <TextView
                android:id="@+id/tab_settings_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textStyle="bold" />

            <View
                android:id="@+id/tab_settings_indicator"
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/tab_indicator_dot"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

    <!-- 三个 Tab 的子 Fragment 容器（show/hide 复用，避免重建） -->
    <FrameLayout
        android:id="@+id/tab_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
</LinearLayout>
